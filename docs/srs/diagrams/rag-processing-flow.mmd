%%{init: {"theme": "base", "flowchart": {"curve": "basis"}, "themeVariables": {"fontFamily": "Arial", "primaryColor": "#F7F1E6", "primaryTextColor": "#2F2418", "primaryBorderColor": "#8A6537", "lineColor": "#6F655A", "secondaryColor": "#E8F1EE", "tertiaryColor": "#F4F5F7"}}}%%
flowchart TB
    subgraph INGESTION["Document Ingestion and Indexing"]
        UPLOAD["Admin or assigned HeadLecturer<br/>uploads a supported course document"]
        VALIDATE{"Supported type and<br/>valid file signature?"}
        REJECT["Reject upload<br/>No file or metadata persisted"]
        SAVE["Save generated file name locally<br/>Persist metadata as Uploaded"]
        EXTRACT["Extract text<br/>PDF / DOCX / PPTX / best-effort PPT"]
        HAS_TEXT{"Text extracted?"}
        CHUNK["Split text using the runtime<br/>chunking service defaults"]
        EMBED["Generate an embedding<br/>for each chunk"]
        PERSIST["Transactionally replace old chunk data<br/>Persist chunks and vectors<br/>Mark document Indexed"]
        FAILED["Mark document Failed<br/>Store error message"]

        UPLOAD --> VALIDATE
        VALIDATE -->|"No"| REJECT
        VALIDATE -->|"Yes"| SAVE
        SAVE --> EXTRACT
        EXTRACT --> HAS_TEXT
        HAS_TEXT -->|"No or processing error"| FAILED
        HAS_TEXT -->|"Yes"| CHUNK
        CHUNK --> EMBED
        EMBED --> PERSIST
        EMBED -.->|"Provider or persistence error"| FAILED
    end

    subgraph QUERY["Course-Scoped RAG Question Answering"]
        QUESTION["Authenticated user submits<br/>course and question"]
        SCOPE{"Course allowed?<br/>Admin / Student: pass course authorization gate<br/>HeadLecturer / Lecturer: same department + explicit assignment"}
        DENY["Reject request<br/>Return validation or access error"]
        USERMSG["Resolve user-owned session<br/>Persist user message"]
        QEMBED["Generate question embedding"]
        RETRIEVE["Load Indexed documents for course<br/>Rank stored vectors by similarity<br/>Keep qualifying top-ranked chunks"]
        FOUND{"Relevant chunks found?"}
        CONTEXT["Build source-labelled context<br/>with document names and relevance"]
        EMPTY["Build prompt with explicit<br/>empty-context marker"]
        LLM["Gemini generates grounded answer<br/>under no-invention guardrail"]
        ANSWER["Persist assistant answer"]
        CITE["Persist one citation per retrieved chunk<br/>Return answer, snippets, sources, scores"]
        NOCITE["Return guarded no-context answer<br/>with no citations and score 0"]

        QUESTION --> SCOPE
        SCOPE -->|"No"| DENY
        SCOPE -->|"Yes"| USERMSG
        USERMSG --> QEMBED
        QEMBED --> RETRIEVE
        RETRIEVE --> FOUND
        FOUND -->|"Yes"| CONTEXT
        FOUND -->|"No"| EMPTY
        CONTEXT --> LLM
        EMPTY --> LLM
        LLM --> ANSWER
        ANSWER -->|"Chunks retrieved"| CITE
        ANSWER -->|"No chunks retrieved"| NOCITE
    end

    PERSIST -.->|"Indexed course data"| RETRIEVE

    classDef action fill:#FFFDF8,stroke:#9A7648,color:#2F2418,stroke-width:1.5px;
    classDef decision fill:#F7F1E6,stroke:#5B3B17,color:#2F2418,stroke-width:2px;
    classDef success fill:#E8F1EE,stroke:#4F7467,color:#203B34,stroke-width:1.5px;
    classDef failure fill:#F8E8E5,stroke:#A4584C,color:#5C2821,stroke-width:1.5px;
    class UPLOAD,SAVE,EXTRACT,CHUNK,EMBED,QUESTION,USERMSG,QEMBED,RETRIEVE,CONTEXT,EMPTY,LLM,ANSWER action;
    class VALIDATE,HAS_TEXT,SCOPE,FOUND decision;
    class PERSIST,CITE,NOCITE success;
    class REJECT,FAILED,DENY failure;
