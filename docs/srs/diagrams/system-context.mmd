flowchart LR
    subgraph PEOPLE["System Users"]
        ADMIN["Admin<br/>Courses, staff, all documents,<br/>model operations"]
        HEAD["HeadLecturer<br/>Assigned-course uploads<br/>and model operations"]
        LECTURER["Lecturer<br/>Assigned-course metadata<br/>and chat"]
        STUDENT["Student<br/>Course-document chat"]
    end

    subgraph SYSTEM["PRN222 RAG Workbench - ASP.NET Core MVC"]
        WEB["Web Application<br/>Identity, role authorization,<br/>course-scoped workflows"]
        FILES["Managed Upload Storage<br/>Application-controlled saved files"]
    end

    SQL[("SQL Server<br/>Users, courses, metadata,<br/>chunks, vectors, chat, evaluation")]
    SOURCE["Course Document Files (Input)<br/>PDF / DOCX / PPTX / PPT"]
    GEMINI["Google Gemini<br/>Default embeddings, answers,<br/>Q and A generation"]
    HF["Hugging Face<br/>Optional multilingual E5 embeddings<br/>and fine-tuned inference"]

    ADMIN -->|"Manage and evaluate"| WEB
    HEAD -->|"Operate assigned courses"| WEB
    LECTURER -->|"View and chat within assignments"| WEB
    STUDENT -->|"Ask course questions"| WEB

    SOURCE -->|"Submit input artifact"| WEB
    WEB -->|"Validate, rename, and store"| FILES
    FILES -->|"Read for extraction"| WEB
    WEB <-->|"Persist and query application data"| SQL
    WEB <-->|"Prompts, answers, embeddings"| GEMINI
    WEB <-->|"Optional embeddings and inference"| HF

    classDef person fill:#FFFDF8,stroke:#9A7648,color:#2F2418,stroke-width:1.5px;
    classDef system fill:#F7F1E6,stroke:#5B3B17,color:#2F2418,stroke-width:2px;
    classDef external fill:#E8F1EE,stroke:#4F7467,color:#203B34,stroke-width:1.5px;
    class ADMIN,HEAD,LECTURER,STUDENT person;
    class WEB,FILES system;
    class SQL,SOURCE,GEMINI,HF external;
