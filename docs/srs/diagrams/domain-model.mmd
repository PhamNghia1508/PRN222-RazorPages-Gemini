%%{init: {"theme": "base", "flowchart": {"curve": "stepAfter", "nodeSpacing": 45, "rankSpacing": 65}, "themeVariables": {"fontFamily": "Arial", "primaryColor": "#FFFDF8", "primaryTextColor": "#2F2418", "primaryBorderColor": "#8A6537", "lineColor": "#6F655A", "secondaryColor": "#E8F1EE", "tertiaryColor": "#F4F5F7"}}}%%
flowchart LR
    subgraph IDENTITY["Identity and Course Scope"]
        direction TB
        USER["ApplicationUser<br/><small>Id (PK), Email</small>"]
        ASSIGN["ApplicationUserCourse<br/><small>UserId + CourseId (composite PK)<br/>AssignedAt</small>"]
        COURSE["Course<br/><small>Id (PK), Name, Description</small>"]

        USER -->|"1 to 0..* assignments"| ASSIGN
        COURSE -->|"1 to 0..* assignments"| ASSIGN
        ID_NOTE["Cross-group relationships<br/><small>Course 1 to 0..* Document<br/>ApplicationUser 1 to 0..* ChatSession<br/>Course 1 to 0..* QAPair<br/>Course 0..1 per BenchmarkRun; 0..* runs per course</small>"]
    end

    subgraph KNOWLEDGE["Knowledge and Retrieval"]
        direction TB
        DOCUMENT["Document<br/><small>Id (PK), CourseId (FK)<br/>EmbeddingModelId (optional FK), Status</small>"]
        CHUNK["DocumentChunk<br/><small>Id (PK), DocumentId (FK)<br/>ChunkIndex, Content</small>"]
        VECTOR["ChunkEmbedding<br/><small>Id (PK), ChunkId (FK)<br/>EmbeddingModelName, EmbeddingVector</small>"]
        MODEL["EmbeddingModel<br/><small>Id (PK), Name, Provider<br/>Dimensions, IsActive</small>"]

        DOCUMENT -->|"1 to 0..* chunks"| CHUNK
        CHUNK -->|"1 to 0..* vectors"| VECTOR
        KB_NOTE["Model and cross-group relationships<br/><small>Document 0..1 EmbeddingModel; 0..* documents per model<br/>DocumentChunk 1 to 0..* ChatCitation<br/>DocumentChunk 0..1 source per QAPair; 0..* QAPairs per chunk<br/>EmbeddingModel 1 per BenchmarkRun; 0..* runs per model</small>"]
    end

    subgraph CHAT["Chat and Evidence"]
        direction TB
        SESSION["ChatSession<br/><small>Id (PK), UserId (FK), SessionTitle</small>"]
        MESSAGE["ChatMessage<br/><small>Id (PK), SessionId (FK)<br/>Role, optional retrieval score</small>"]
        CITATION["ChatCitation<br/><small>Id (PK), MessageId (FK)<br/>ChunkId (FK), RelevanceScore</small>"]

        SESSION -->|"1 to 0..* messages"| MESSAGE
        MESSAGE -->|"1 to 0..* citations"| CITATION
    end

    subgraph EVALUATION["Dataset and Evaluation"]
        direction TB
        QA["QAPair<br/><small>Id (PK), CourseId (FK)<br/>DocumentChunkId (optional FK)</small>"]
        RUN["BenchmarkRun<br/><small>Id (PK), EmbeddingModelId (FK)<br/>CourseId (optional FK), Status</small>"]
        RESULT["BenchmarkResult<br/><small>Id (PK), BenchmarkRunId (FK)<br/>Question, GroundTruth, GeneratedAnswer</small>"]

        RUN -->|"1 to 0..* results"| RESULT
    end

    classDef identity fill:#FFFDF8,stroke:#9A7648,color:#2F2418,stroke-width:1.5px;
    classDef knowledge fill:#F7F1E6,stroke:#5B3B17,color:#2F2418,stroke-width:1.5px;
    classDef chat fill:#E8F1EE,stroke:#4F7467,color:#203B34,stroke-width:1.5px;
    classDef evaluation fill:#F4F5F7,stroke:#66717A,color:#263038,stroke-width:1.5px;
    classDef note fill:#FFFFFF,stroke:#A9A29A,color:#4A433C,stroke-dasharray: 5 5;
    class USER,ASSIGN,COURSE identity;
    class DOCUMENT,CHUNK,VECTOR,MODEL knowledge;
    class SESSION,MESSAGE,CITATION chat;
    class QA,RUN,RESULT evaluation;
    class ID_NOTE,KB_NOTE note;
