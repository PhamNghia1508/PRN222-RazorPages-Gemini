            function showError(message) {
                chatError.textContent = message;
                chatError.style.display = 'block';
            }

            function hideError() {
                chatError.textContent = '';
                chatError.style.display = 'none';
            }

            function scrollToBottom() {
                chatContainer.scrollTop = chatContainer.scrollHeight;
            }

            function escapeHtml(unsafe) {
                if (!unsafe) return '';
                return unsafe
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            function parseQuizBlock(rawText) {
                const quizRegex = /\[QUIZ\]([\s\S]*?)\[\/QUIZ\]/gi;
                return rawText.replace(quizRegex, function (match, p1) {
                    const clean = p1.replace(/<\/?p>/gi, '\n').replace(/<br\s*\/?>/gi, '\n').trim();
                    const questionsRaw = clean.split(/(?=Q:)/gi);
                    let quizHtml = '<div class="poetic-quiz-wrapper">';
                    let qCount = 0;

                    questionsRaw.forEach(qBlock => {
                        if (!qBlock.trim()) return;

                        const qMatch = qBlock.match(/Q:\s*([\s\S]*?)(?=[A-D]\s*[\)\.]|Answer:|Đáp án:|Explanation:|Giải thích:|$)/i);
                        if (!qMatch) return;
                        const questionText = qMatch[1].trim();

                        const getOption = (block, letter) => {
                            const regex = new RegExp(`[${letter}]\\s*[\\)\\.]\\s*([\\s\\S]*?)(?=[A-D]\\s*[\\)\\.]|Answer:|Đáp án:|Explanation:|Giải thích:|$|\\n)`, 'i');
                            const m = block.match(regex);
                            return m ? m[1].trim() : null;
                        };

                        const options = [];
                        ['A', 'B', 'C', 'D'].forEach(letter => {
                            const optText = getOption(qBlock, letter);
                            if (optText) {
                                options.push({ label: letter, text: optText });
                            }
                        });

                        const ansMatch = qBlock.match(/(?:Answer|Đáp án):\s*([A-D])/i);
                        const correctAnswer = ansMatch ? ansMatch[1].toUpperCase() : 'A';

                        const expMatch = qBlock.match(/(?:Explanation|Giải thích):\s*([\s\S]*?)$/i);
                        const explanation = expMatch ? expMatch[1].trim() : '';

                        const qId = 'quiz_q_' + Math.random().toString(36).substring(2, 9);
                        qCount++;

                        quizHtml += `
                            <div class="poetic-quiz-card" id="${qId}" data-correct="${correctAnswer}">
                                <div class="poetic-quiz-qtext"><b>Câu hỏi ${qCount}:</b> ${questionText}</div>
                                <div class="poetic-quiz-options">
                        `;

                        options.forEach(opt => {
                            quizHtml += `
                                <div class="poetic-quiz-option" data-val="${opt.label}">
                                    <span class="poetic-quiz-opt-letter">${opt.label}</span>
                                    <span class="poetic-quiz-opt-text">${opt.text}</span>
                                </div>
                            `;
                        });

                        quizHtml += `
                                </div>
                                <button type="button" class="poetic-quiz-submit btn-poetic-quiz" disabled>Kiểm tra đáp án</button>
                                <div class="poetic-quiz-explanation" style="display: none;">
                                    <div class="poetic-quiz-result-header"></div>
                                    <p>${explanation}</p>
                                </div>
                            </div>
                        `;
                    });

                    quizHtml += '</div>';
                    return quizHtml;
                });
            }

            function parseFlashcardsBlock(rawText) {
                const fcRegex = /\[FLASHCARDS\]([\s\S]*?)\[\/FLASHCARDS\]/gi;
                return rawText.replace(fcRegex, function (match, p1) {
                    const clean = p1.replace(/<\/?p>/gi, '\n').replace(/<br\s*\/?>/gi, '\n').trim();
                    const cardsRaw = clean.split(/(?=Front:)/gi);
                    let fcHtml = '<div class="poetic-flashcards-container">';

                    cardsRaw.forEach(cBlock => {
                        if (!cBlock.trim()) return;

                        const frontMatch = cBlock.match(/Front:\s*([\s\S]*?)(?=Back:|$)/i);
                        const backMatch = cBlock.match(/Back:\s*([\s\S]*?)$/i);

                        if (!frontMatch || !backMatch) return;

                        const frontText = frontMatch[1].trim();
                        const backText = backMatch[1].trim();

                        fcHtml += `
                            <div class="poetic-flashcard">
                                <div class="poetic-flashcard-inner">
                                    <div class="poetic-flashcard-front">
                                        <h4>${frontText}</h4>
                                        <span>Click to Reveal</span>
                                    </div>
                                    <div class="poetic-flashcard-back">
                                        <p>${backText}</p>
                                    </div>
                                </div>
                            </div>
                        `;
                    });

                    fcHtml += '</div>';
                    return fcHtml;
                });
            }

            function initInteractiveWidgets($container) {
                // Quiz option click handler
                $container.find('.poetic-quiz-option').off('click').on('click', function () {
                    const $option = $(this);
                    const $card = $option.closest('.poetic-quiz-card');

                    if ($card.hasClass('checked')) return;

                    $card.find('.poetic-quiz-option').removeClass('selected');
                    $option.addClass('selected');
                    $card.find('.poetic-quiz-submit').prop('disabled', false);
                });

                // Quiz check button click handler
                $container.find('.poetic-quiz-submit').off('click').on('click', function () {
                    const $btn = $(this);
                    const $card = $btn.closest('.poetic-quiz-card');
                    const selectedVal = $card.find('.poetic-quiz-option.selected').data('val');
                    const correctVal = $card.data('correct');

                    if (!selectedVal) return;

                    $card.addClass('checked');
                    $btn.hide();

                    const $explanation = $card.find('.poetic-quiz-explanation');
                    const $resultHeader = $card.find('.poetic-quiz-result-header');

                    $card.find('.poetic-quiz-option').each(function () {
                        const $opt = $(this);
                        const val = $opt.data('val');
                        if (val === correctVal) {
                            $opt.addClass('correct');
                        } else if (val === selectedVal) {
                            $opt.addClass('incorrect');
                        }
                    });

                    if (selectedVal === correctVal) {
                        $resultHeader.html('<span class="status-correct"><i class="ph-fill ph-check-circle"></i> Chính xác!</span>').addClass('text-success');
                    } else {
                        $resultHeader.html(`<span class="status-incorrect"><i class="ph-fill ph-x-circle"></i> Sai rồi (Đáp án đúng là ${correctVal})</span>`).addClass('text-danger');
                    }

                    $explanation.slideDown(250);
                });

                // Flashcard flip
                $container.find('.poetic-flashcard').off('click').on('click', function () {
                    $(this).toggleClass('flipped');
                });

                // Bookmark button state & click handler
                const bookmarks = getBookmarks();
                $container.find('.poetic-msg-bookmark-btn').each(function () {
                    const $btn = $(this);
                    const $msg = $btn.closest('.poetic-message');
                    const textContent = $msg.find('.parsed-content').text().trim();
                    const isBookmarked = bookmarks.some(b => b.textContent === textContent);
                    if (isBookmarked) {
                        $btn.addClass('bookmarked');
                        $btn.find('i').removeClass('ph-light').addClass('ph-fill');
                    } else {
                        $btn.removeClass('bookmarked');
                        $btn.find('i').removeClass('ph-fill').addClass('ph-light');
                    }
                });

                $container.find('.poetic-msg-bookmark-btn').off('click').on('click', function () {
                    const $btn = $(this);
                    const $msg = $btn.closest('.poetic-message');
                    const htmlContent = $msg.find('.parsed-content').html() || '';
                    const textContent = $msg.find('.parsed-content').text().trim();
                    const courseName = $('#courseSelect option:selected').text() || 'Học liệu';
                    const title = courseName + ' - ' + new Date().toLocaleDateString('vi-VN');

                    let currentBookmarks = getBookmarks();
                    const index = currentBookmarks.findIndex(b => b.textContent === textContent);
                    if (index > -1) {
                        currentBookmarks.splice(index, 1);
                        $btn.removeClass('bookmarked');
                        $btn.find('i').removeClass('ph-fill').addClass('ph-light');
                    } else {
                        const id = 'bm_' + Date.now();
                        currentBookmarks.push({ id, title, htmlContent, textContent });
                        $btn.addClass('bookmarked');
                        $btn.find('i').removeClass('ph-light').addClass('ph-fill');
                    }
                    saveBookmarks(currentBookmarks);
                    updateBookmarkBadge();
                    loadNotebookBookmarks();
                });
            }

            // Bookmark / Notebook helper functions
            function getBookmarks() {
                try {
                    return JSON.parse(localStorage.getItem('poetic_bookmarks') || '[]');
                } catch (e) {
                    return [];
                }
            }

            function saveBookmarks(bookmarks) {
                localStorage.setItem('poetic_bookmarks', JSON.stringify(bookmarks));
            }

            function updateBookmarkBadge() {
                const count = getBookmarks().length;
                $('#bookmarkCount').text(count);
            }

            function loadNotebookBookmarks() {
                const content = $('#notebookDrawerContent');
                const bookmarks = getBookmarks();
                content.empty();

                if (bookmarks.length === 0) {
                    content.html('<div class="poetic-drawer-empty"><i class="ph-light ph-notebook"></i>Sổ tay đang trống.<br><span style="font-size: 12px; color: #8A7A6A;">Di chuột vào câu trả lời của AI và chọn biểu tượng lưu để lưu lại.</span></div>');
                    return;
                }

                bookmarks.forEach(b => {
                    content.append(`
                        <div class="poetic-notebook-card" data-id="${b.id}">
                            <h4>${escapeHtml(b.title)}</h4>
                            <div class="poetic-notebook-card-content" style="max-height: 150px; overflow-y: auto; margin-bottom: 10px;">
                                ${b.htmlContent}
                            </div>
                            <div class="poetic-notebook-card-actions">
                                <button class="poetic-notebook-card-btn btn-copy" data-id="${b.id}">
                                    <i class="ph-light ph-copy"></i> Sao chép
                                </button>
                                <button class="poetic-notebook-card-btn btn-delete" data-id="${b.id}">
                                    <i class="ph-light ph-trash"></i> Xóa
                                </button>
                            </div>
                        </div>
                    `);
                });

                // Bind copy action
                content.find('.btn-copy').on('click', function () {
                    const id = $(this).data('id');
                    const item = getBookmarks().find(x => x.id === id);
                    if (item) {
                        const textToCopy = item.textContent;
                        const $btn = $(this);
                        navigator.clipboard.writeText(textToCopy).then(() => {
                            const originalText = $btn.html();
                            $btn.html('<i class="ph-fill ph-check-circle" style="color: #28a745;"></i> Đã chép');
                            setTimeout(() => {
                                $btn.html(originalText);
                            }, 1500);
                        });
                    }
                });

                // Bind delete action
                content.find('.btn-delete').on('click', function () {
                    const id = $(this).data('id');
                    let bookmarksList = getBookmarks();
                    const item = bookmarksList.find(x => x.id === id);
                    bookmarksList = bookmarksList.filter(x => x.id !== id);
                    saveBookmarks(bookmarksList);
                    updateBookmarkBadge();
                    loadNotebookBookmarks();

                    // Find corresponding bookmark buttons in main chat and reset icon
                    if (item) {
                        $('.poetic-message.assistant').each(function () {
                            const $msg = $(this);
                            const textContent = $msg.find('.parsed-content').text().trim();
                            if (textContent === item.textContent) {
                                const $btn = $msg.find('.poetic-msg-bookmark-btn');
                                $btn.removeClass('bookmarked');
                                $btn.find('i').removeClass('ph-fill').addClass('ph-light');
                            }
                        });
                    }
                });
            }

            // Focus mode keeps the chat centered and hides secondary chrome.
            function applyFocusMode(isFocusMode) {
                $('.app-shell').toggleClass('poetic-zen', isFocusMode);
                $('body').toggleClass('chat-focus-mode', isFocusMode);
                $('#zenModeBtn')
                    .attr('aria-pressed', isFocusMode ? 'true' : 'false')
                    .attr('title', isFocusMode ? 'Thoát chế độ tập trung' : 'Chế độ tập trung');

                if (isFocusMode) {
                    $('#zenIcon').removeClass('ph-eye-slash').addClass('ph-eye');
                    $('#zenText').text('Thoát tập trung');
                } else {
                    $('#zenIcon').removeClass('ph-eye').addClass('ph-eye-slash');
                    $('#zenText').text('Tập trung');
                }

                window.localStorage.setItem('chatFocusMode', isFocusMode ? '1' : '0');
                window.setTimeout(scrollToBottom, 240);
            }

            applyFocusMode(window.localStorage.getItem('chatFocusMode') === '1');

            $('#zenModeBtn').on('click', function () {
                applyFocusMode(!$('.app-shell').hasClass('poetic-zen'));
                questionInput.focus();
            });

            // Notebook Drawer Handlers
            const notebookDrawer = $('#notebookDrawer');
            const notebookDrawerBackdrop = $('#notebookDrawerBackdrop');

            $('#openNotebookDrawerBtn').on('click', function () {
                loadNotebookBookmarks();
                notebookDrawer.addClass('open');
                notebookDrawerBackdrop.fadeIn(200);
            });

            $('#closeNotebookDrawerBtn, #notebookDrawerBackdrop').on('click', function () {
                notebookDrawer.removeClass('open');
                notebookDrawerBackdrop.fadeOut(200);
            });

            // Init badge count on load
            updateBookmarkBadge();
        });
    </script>
}

