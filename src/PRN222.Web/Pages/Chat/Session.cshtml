                updateSuggestions(selectedText);
                refreshCourseDocumentHint($(this).val(), selectedText);
            });

            // Drawer Handlers
            const docDrawer = $('#docDrawer');
            const docDrawerBackdrop = $('#docDrawerBackdrop');

            $('#openDocDrawerBtn').on('click', function () {
                const courseId = $('#courseSelect').val();
                loadCourseDocuments(courseId);
                docDrawer.addClass('open');
                docDrawerBackdrop.fadeIn(200);
            });

            $('#closeDocDrawerBtn, #docDrawerBackdrop').on('click', function () {
