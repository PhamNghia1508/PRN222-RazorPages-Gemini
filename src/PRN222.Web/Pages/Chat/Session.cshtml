                docDrawerBackdrop.fadeOut(200);
            });

            // Page Initialization
            const initialCourseText = $('#courseSelect').find('option:selected').text();
            if (initialCourseText) {
                updateSuggestions(initialCourseText);
                refreshCourseDocumentHint($('#courseSelect').val(), initialCourseText);
            }

            // Export Chat to Markdown File
            $('#exportMarkdownBtn').on('click', function () {
                const messages = $('.poetic-message');
                if (messages.length <= 1) {
                    showChatToast('Chưa có nội dung cuộc đối thoại để xuất sổ tay.', true, 'Chưa có dữ liệu');
                    return;
                }

                let markdown = `# Nhật ký học tập: ${document.title || 'Phiên vấn đáp'}\n`;
                markdown += `*Thời gian xuất: ${new Date().toLocaleString('vi-VN')}*\n\n---\n\n`;

                messages.each(function () {
                    const $msg = $(this);
                    if ($msg.attr('id') === 'typingIndicator') return;

                    const isUser = $msg.hasClass('user');
                    const role = isUser ? 'Sinh viên' : 'Trợ lý AI';
                    const text = isUser
                        ? $msg.find('.chat-user-text').text().trim()
                        : $msg.find('.parsed-content').text().trim();

                    if (!text) return;

                    markdown += `### ✦ ${role}:\n${text}\n\n`;

                    if (!isUser) {
                        const citations = $msg.find('.poetic-library-card');
                        if (citations.length > 0) {
                            markdown += `*Tài liệu tham chiếu:*\n`;
                            citations.each(function () {
                                const title = $(this).find('h4 span').first().text().trim();
                                const snippet = $(this).find('p').text().trim();
                                markdown += `> - **${title}**: ${snippet}\n`;
                            });
                            markdown += `\n`;
                        }
                    }
                    markdown += `---\n\n`;
                });

                const blob = new Blob([markdown], { type: 'text/markdown;charset=utf-8;' });
                const link = document.createElement('a');
                const url = URL.createObjectURL(blob);
                link.href = url;
                link.setAttribute('download', `study_note_${new Date().toISOString().slice(0,10)}.md`);
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            });

            $('#chatForm').on('submit', function () {
                const question = questionInput.val().trim();
                const courseId = $('#courseSelect').val();
                let sessionId = $('#sessionId').val();

                if (!question) {
                    questionInput.focus();
                    return;
                }

                hideError();
                $('#emptyState').hide();
                appendUserMessage(question);

                // Clear and reset textarea height
                questionInput.val('');
                questionInput.css('height', 'auto');

                setBusy(true);

                $.ajax({
                    url: '/Chat/Session?handler=Ask',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    contentType: 'application/json',
                    data: JSON.stringify({
                        sessionId: (sessionId && sessionId.length > 0) ? parseInt(sessionId) : null,
                        courseId: parseInt(courseId),
                        question: question
                    }),
                    success: function (res) {
                        if ((!sessionId || sessionId.length === 0) && res.sessionId) {
                            $('#sessionId').val(res.sessionId);
                            window.history.pushState({}, '', '/Chat/Session/' + res.sessionId);
                        }

                        appendAssistantMessage(res);
                        scrollToBottom();
                    },
                    error: function (xhr) {
                        // Restore question text if failed so the user doesn't lose their input
                        questionInput.val(question);
                        questionInput.trigger('input');
                        const message = xhr.responseJSON?.error || 'Không thể kết nối tới hệ thống hỏi đáp.';
                        showError(message);
                    },
                    complete: function () {
                        setBusy(false);
                        questionInput.focus();
                    }
                });
            });

            function setBusy(isBusy) {
                $('#typingIndicator').toggle(isBusy);
                questionInput.prop('disabled', isBusy);
                sendButton.prop('disabled', isBusy);
                scrollToBottom();
            }
            function appendUserMessage(text) {
                const msgHtml = `
                    <div class="poetic-message user">
                        <div class="poetic-bubble">
                            <div class="chat-user-text">${escapeHtml(text)}</div>
                        </div>
                        <div class="poetic-avatar"><i class="ph-light ph-user"></i></div>
                    </div>`;

                $(msgHtml).insertBefore('#typingIndicator');
            }

            function appendAssistantMessage(data) {
                const citationsHtml = renderCitations(data.citations || []);
                const content = renderMarkdown(data.content || '');
                const citationsJson = JSON.stringify(data.citations || []);
                const isHelpfulUp = data.isHelpful === true || data.IsHelpful === true;
                const isHelpfulDown = data.isHelpful === false || data.IsHelpful === false;
                const messageId = data.id || data.Id;
                const msgHtml = `
                    <div class="poetic-message assistant" data-citations="${escapeHtml(citationsJson)}">
                        <div class="poetic-avatar">✦</div>
                        <div style="flex: 1;">
                            <div class="poetic-bubble">
                                <div class="parsed-content">${content}</div>
                            </div>
                            <div class="poetic-message-actions">
                                <button type="button" class="poetic-msg-bookmark-btn" title="Lưu vào Sổ tay">
                                    <i class="ph-light ph-bookmark-simple"></i> <span>Lưu sổ tay</span>
                                </button>
                                <button type="button" class="poetic-msg-feedback-btn feedback-up ${isHelpfulUp ? 'active' : ''}" data-message-id="${messageId}" data-helpful="true" title="Hữu ích">
                                    <i class="${isHelpfulUp ? 'ph-fill' : 'ph-light'} ph-thumbs-up"></i>
                                </button>
                                <button type="button" class="poetic-msg-feedback-btn feedback-down ${isHelpfulDown ? 'active' : ''}" data-message-id="${messageId}" data-helpful="false" title="Không hữu ích">
                                    <i class="${isHelpfulDown ? 'ph-fill' : 'ph-light'} ph-thumbs-down"></i>
                                </button>
                            </div>
                            ${citationsHtml}
                        </div>
                    </div>`;

                const $msg = $(msgHtml).insertBefore('#typingIndicator');
                initCodeRunners($msg);
                initInteractiveWidgets($msg);

                // Update the right-hand evidence panel immediately
                updateEvidencePanel(data.citations || []);
            }

            function renderMarkdown(raw) {
                const text = raw || '';
                if (!window.marked || !window.DOMPurify) {
                    return escapeHtml(text).replace(/\n/g, '<br>');
                }

                const renderer = new marked.Renderer();
                const originalCode = renderer.code.bind(renderer);
                renderer.code = function (code, language, escaped) {
                    const langLower = (language || '').toLowerCase().trim();
                    if (codeExecutionEnabled &&
                        (langLower === 'csharp' || langLower === 'cs' || langLower === 'c#' || !langLower)) {
                        const codeText = typeof code === 'object' ? code.text : code;
                        return `
                            <div class="code-sandbox-container" style="position: relative;">
                                <button class="btn-run-code" data-code="${escapeHtml(codeText)}">
                                    <i class="ph-light ph-play"></i> Run Code
                                </button>
                                ${originalCode(code, language, escaped)}
                            </div>`;
                    }
                    return originalCode(code, language, escaped);
                };

                let html = marked.parse(text, { renderer: renderer });

                // Custom parsing for interactive Quiz and Flashcard modules
                html = parseQuizBlock(html);
                html = parseFlashcardsBlock(html);

                // Run DOMPurify at the very end to ensure all text within custom blocks is sanitized
                html = DOMPurify.sanitize(html, {
                    USE_PROFILES: { html: true },
                    ADD_TAGS: ['button', 'i'],
                    ADD_ATTR: ['data-code', 'data-correct', 'data-val', 'disabled']
                });

                return html;
            }

            function initCodeRunners($container) {
                $container.find('.btn-run-code').off('click').on('click', function() {
                    const code = $(this).data('code') || '';
                    $('#playgroundCodeEditor').val(code);
                    $('#playgroundOutput').text('Nhấn "Thực thi Code" để biên dịch và chạy chương trình...').css('color', '#8A7A6A');
                    $('#playgroundRunBtn').prop('disabled', false).html('<i class="ph-light ph-play"></i> Thực thi Code');

                    const modalEl = document.getElementById('codePlaygroundModal');
                    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                    modal.show();
                });
            }

            // Sân chơi Code Sandbox Runner
            $('#playgroundRunBtn').on('click', function () {
                const code = $('#playgroundCodeEditor').val();
                const $btn = $(this);
                const $output = $('#playgroundOutput');

                $btn.prop('disabled', true).html('<i class="ph-light ph-hourglass"></i> Đang chạy...');
                $output.text('Đang biên dịch và thực thi trên server...').css('color', '#00FF00');

                $.ajax({
                    url: '/CodeRunner?handler=Execute',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: JSON.stringify({ code: code }),
                    success: function (res) {
                        $output.text(res.output).css('color', '#00FF00');
                    },
                    error: function (xhr) {
                        $output.text(xhr.responseJSON?.error || 'Lỗi khi thực thi code.').css('color', '#FF3B30');
                    },
                    complete: function () {
                        $btn.prop('disabled', false).html('<i class="ph-light ph-play"></i> Thực thi Code');
                    }
                });
            });

            function renderCitations(citations) {
                if (!citations.length) return '';

                const cards = citations.map(citation => {
                    let imgHtml = '';
                    const imgUrlVal = citation.imageUrl ?? citation.ImageUrl;
                    const docNameVal = citation.documentName ?? citation.DocumentName ?? 'Tài liệu';
                    const startPageVal = citation.startPage ?? citation.StartPage ?? 0;
                    const snippetVal = citation.snippetText ?? citation.SnippetText ?? '';

                    if (imgUrlVal) {
                        imgHtml = `
                            <div class="citation-image-wrapper image-zoom-trigger" data-image-url="${escapeHtml(imgUrlVal)}" onclick="event.stopPropagation();">
                                <img src="${escapeHtml(imgUrlVal)}" class="citation-thumbnail" alt="Minh chứng trích dẫn" />
                            </div>`;
                    }
                    return `
                        <div class="poetic-library-card citation-toggle">
                            <h4>
                                <span><i class="ph-light ph-quotes"></i> ${escapeHtml(docNameVal)} (Trang ${escapeHtml(String(startPageVal))})</span>
                                <span class="expand-icon"><i class="ph-light ph-caret-down"></i></span>
                            </h4>
                            <p>${escapeHtml(snippetVal)}</p>
                            ${imgHtml}
                        </div>`;
                }).join('');

                return `<div class="poetic-citations-grid">${cards}</div>`;
            }

            function updateEvidencePanel(citations) {
                const $list = $('#retrievedContextList');
                const $count = $('.chat-evidence-count');

                $count.text(citations.length);
                $list.empty();

                if (!citations || citations.length === 0) {
                    $list.append(`
                        <div class="chat-evidence-empty" style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 40px 20px; color: #8A7A6A;">
                            <i class="ph-light ph-magnifying-glass" style="font-size: 48px; color: var(--accent-color); margin-bottom: 12px;"></i>
                            <h3 style="font-size: 15px; font-weight: 600; color: var(--ink-900); margin-bottom: 6px;">Chưa có ngữ cảnh</h3>
                            <p style="font-size: 13px; max-width: 240px; margin: 0; line-height: 1.4;">Đặt câu hỏi học tập để xem các đoạn tài liệu được truy xuất và độ liên quan.</p>
                        </div>
                    `);
                    return;
                }

                citations.forEach(c => {
                    let imgHtml = '';
                    const imgUrlVal = c.imageUrl ?? c.ImageUrl;
                    const docNameVal = c.documentName ?? c.DocumentName ?? 'Tài liệu';
                    const startPageVal = c.startPage ?? c.StartPage ?? 0;
                    const snippetVal = c.snippetText ?? c.SnippetText ?? '';

                    if (imgUrlVal) {
                        imgHtml = `
                            <div class="citation-image-wrapper image-zoom-trigger" data-image-url="${escapeHtml(imgUrlVal)}">
                                <img src="${escapeHtml(imgUrlVal)}" class="citation-thumbnail" alt="Minh chứng trích dẫn" />
                            </div>`;
                    }

                    const score = typeof c.relevanceScore === 'number'
                        ? (c.relevanceScore * 100).toFixed(0) + '%'
                        : (typeof c.RelevanceScore === 'number' ? (c.RelevanceScore * 100).toFixed(0) + '%' : '100%');

                    $list.append(`
                        <article class="chat-evidence-card" style="background: #fff; border: 1px solid var(--sand-300); border-radius: 8px; padding: 12px; transition: all 0.2s;">
                            <div class="chat-evidence-card-top" style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 6px;">
                                <span class="chat-evidence-score" style="color: var(--accent-color); font-weight: 700;">Độ tương đồng: ${score}</span>
                                <span class="chat-evidence-page" style="color: #8A7A6A; font-weight: 500;">Trang ${startPageVal}</span>
                            </div>
                            <strong style="display: block; font-size: 13px; color: var(--ink-900); margin-bottom: 4px; font-family: var(--font-display);">${escapeHtml(docNameVal)}</strong>
                            <p style="font-size: 12.5px; color: var(--ink-800); line-height: 1.5; margin: 0;">${escapeHtml(snippetVal)}</p>
                            ${imgHtml}
                        </article>
                    `);
                });
            }

            // Click assistant message bubble or citation block to show in Evidence Panel
            $(document).on('click', '.poetic-message.assistant .poetic-bubble, .poetic-message.assistant .poetic-citations-grid', function (e) {
                // Ignore clicks on buttons/links/images
                if ($(e.target).closest('button, a, .citation-image-wrapper').length) return;

