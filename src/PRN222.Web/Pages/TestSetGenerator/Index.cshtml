@page "/TestSetGenerator"
@using PRN222.Web.Infrastructure
@model PRN222.Web.Pages.TestSetGenerator.IndexModel
@{
    ViewData["Title"] = "Sinh test set";
    var courseId = Model.CourseId;
    var courses = Model.Courses.ToList();
    var selectedCourse = courses.FirstOrDefault(course => course.Id == courseId);
    var hasCourses = courses.Any();
    var isHeadLecturer = User.IsInRole(ApplicationRoles.HeadLecturer);
    var coverage = Model.Stats.TotalChunksAvailable == 0
        ? 0
        : Math.Round(Model.Stats.UniqueChunksUsed * 100d / Model.Stats.TotalChunksAvailable);
}

<section class="ops-hero testset-hero fade-in-up">
    <div>
        <span class="section-kicker">Evaluation data</span>
        <h1>Sinh test set đánh giá RAG</h1>
        <p>
            Tạo Q&A chuẩn từ chunk tài liệu để benchmark câu trả lời RAG và mô hình fine-tuned theo từng môn học.
        </p>
    </div>
    <div class="hero-action-stack">
        <a asp-page="/Evaluation/Index" class="btn btn-outline-primary">
            <i class="bi bi-graph-up"></i>
            <span>Mở benchmark</span>
        </a>
        <a asp-page="/Document/Index" class="btn btn-primary">
            <i class="bi bi-database"></i>
            <span>Kho tri thức</span>
        </a>
    </div>
</section>

@Html.AntiForgeryToken()

<section class="testset-summary-grid fade-in-up stagger-1" aria-label="Thống kê test set">
    <article class="testset-summary-card">
        <span>Tổng Q&A</span>
        <strong id="statTotal">@Model.Stats.TotalCount</strong>
        <small>Manual + auto-generated</small>
    </article>
    <article class="testset-summary-card">
        <span>Tự sinh</span>
        <strong id="statAuto">@Model.Stats.AutoGeneratedCount</strong>
        <small>Q&A sinh từ tài liệu</small>
    </article>
    <article class="testset-summary-card">
        <span>Coverage</span>
        <strong id="statCoverage">@coverage%</strong>
        <small><span id="statUsed">@Model.Stats.UniqueChunksUsed</span>/<span id="statChunks">@Model.Stats.TotalChunksAvailable</span> chunk đã dùng</small>
    </article>
    <article class="testset-summary-card accent">
        <span>Manual Q&A</span>
        <strong id="statManual">@Model.Stats.ManualCount</strong>
        <small>Dữ liệu nhập tay nếu có</small>
    </article>
</section>

<section class="testset-layout fade-in-up stagger-2">
    <aside class="workspace-panel testset-control-panel">
        <div class="workspace-panel-header">
            <div>
                <span class="section-kicker">Generator</span>
                <h2>Cấu hình sinh Q&A</h2>
                <p>Chọn môn học, giới hạn số chunk và số câu hỏi để kiểm soát thời gian chạy lẫn chi phí API.</p>
            </div>
        </div>

        <div class="testset-config-stack">
            <div class="testset-field">
                <label for="courseSelect">Môn học</label>
                <select id="courseSelect" class="form-select" disabled="@(!hasCourses)">
                    @if (hasCourses)
                    {
                        foreach (var course in courses)
                        {
                            <option value="@course.Id" selected="@(course.Id == courseId)">
                                @course.Name
                            </option>
                        }
                    }
                    else
                    {
                        <option value="">Chưa có môn học</option>
                    }
                </select>
                <small>Test set sẽ gắn với môn đang chọn.</small>
            </div>

            <div class="testset-number-grid">
                <div class="testset-field">
                    <label for="questionsPerChunk">Câu hỏi mỗi chunk</label>
                    <input id="questionsPerChunk" type="number" value="2" min="1" max="5" class="form-control" />
                    <small>Khuyến nghị 1-3 câu để tránh trùng lặp.</small>
                </div>
                <div class="testset-field">
                    <label for="maxChunks">Số chunk tối đa</label>
                    <input id="maxChunks" type="number" value="25" min="1" max="200" class="form-control" />
                    <small>Giới hạn tài liệu được dùng trong một lượt chạy.</small>
                </div>
            </div>

            <div class="testset-estimate">
                <i class="bi bi-calculator"></i>
                <div>
                    <span>Dự kiến tối đa</span>
                    <strong id="estimatedQuestions">50 Q&A</strong>
                </div>
            </div>
        </div>

        @if (!hasCourses)
        {
            <div class="inline-alert inline-alert-danger">
                <i class="bi bi-exclamation-triangle"></i>
                <span>@(isHeadLecturer ? "Bạn chưa được Admin phân công môn để sinh test set." : "Tạo môn học trước khi sinh test set.")</span>
            </div>
        }

        <div class="testset-action-stack">
            <button id="generateBtn" type="button" class="btn btn-primary testset-generate-btn" disabled="@(!hasCourses)">
                <i class="bi bi-stars"></i>
                <span>Sinh test set</span>
            </button>
            <div class="testset-secondary-actions">
                <button id="stopBtn" type="button" class="btn btn-outline-danger" disabled>
                    <i class="bi bi-stop-circle"></i>
                    <span>Dừng job</span>
                </button>
                <button id="clearBtn"
                        type="button"
                        class="btn btn-outline-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#clearAutoModal"
                        disabled="@(!hasCourses)">
                    <i class="bi bi-trash3"></i>
                    <span>Xóa tự sinh</span>
                </button>
            </div>
        </div>

        <div id="jobPanel" class="testset-job-panel d-none">
            <div class="testset-job-head">
                <strong id="jobTitle">Generator</strong>
                <span id="jobState" class="evaluation-status status-muted">Idle</span>
            </div>
            <div class="evaluation-progress-track" aria-label="Tiến độ job">
                <span id="jobProgressBar"></span>
            </div>
            <p id="jobMessage"></p>
        </div>

        <div class="testset-note">
            <i class="bi bi-info-circle"></i>
            <p>
                Q&A tự sinh dùng làm dữ liệu đánh giá. Dữ liệu manual sẽ được giữ nguyên khi bạn xóa Q&A tự sinh.
            </p>
        </div>
    </aside>

    <section class="workspace-panel testset-preview-panel">
        <div class="workspace-panel-header testset-preview-header">
            <div>
                <span class="section-kicker">Preview</span>
                <h2>Q&A tự sinh</h2>
                <p id="previewSubtitle">
                    @(selectedCourse == null ? "Chọn môn học để xem nhanh test set." : $"Đang xem test set của {selectedCourse.Name}.")
                </p>
            </div>
            <label class="testset-page-size" for="previewPageSize">
                <span>Hiển thị</span>
                <select id="previewPageSize" class="form-select form-select-sm" disabled="@(!hasCourses)">
                    <option value="10">10 dòng</option>
                    <option value="25" selected>25 dòng</option>
                    <option value="50">50 dòng</option>
                </select>
            </label>
        </div>

        <div id="previewList" class="testset-preview-list"></div>
        <div id="previewPager" class="testset-preview-pager"></div>
    </section>
</section>

<div class="modal fade" id="clearAutoModal" tabindex="-1" aria-labelledby="clearAutoModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="clearAutoModalTitle">Xóa Q&A tự sinh</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <p>Bạn chắc chắn muốn xóa toàn bộ Q&A auto-generated của môn học đang chọn?</p>
                <p class="text-danger mb-0">Dữ liệu manual Q&A sẽ không bị xóa.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button id="confirmClearBtn" type="button" class="btn btn-danger">
                    <i class="bi bi-trash"></i>
                    <span>Xóa Q&A tự sinh</span>
                </button>
            </div>
        </div>
    </div>
</div>

<div id="testsetToast" class="app-toast d-none" role="status" aria-live="polite"></div>

@section Scripts {
    <script>
        const hasCourseOptions = @(hasCourses ? "true" : "false");
        const fallbackCourseId = @courseId;
        const courseSelect = document.getElementById('courseSelect');
        const questionsPerChunkInput = document.getElementById('questionsPerChunk');
        const maxChunksInput = document.getElementById('maxChunks');
        const estimatedQuestions = document.getElementById('estimatedQuestions');
        const generateBtn = document.getElementById('generateBtn');
        const stopBtn = document.getElementById('stopBtn');
        const clearBtn = document.getElementById('clearBtn');
        const confirmClearBtn = document.getElementById('confirmClearBtn');
        const jobPanel = document.getElementById('jobPanel');
        const jobTitle = document.getElementById('jobTitle');
        const jobState = document.getElementById('jobState');
        const jobProgressBar = document.getElementById('jobProgressBar');
        const jobMessage = document.getElementById('jobMessage');
        const previewList = document.getElementById('previewList');
        const previewPager = document.getElementById('previewPager');
        const previewSubtitle = document.getElementById('previewSubtitle');
        const previewPageSizeSelect = document.getElementById('previewPageSize');
        const toast = document.getElementById('testsetToast');
        const antiforgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

        let previewPage = 1;
        let previewPageSize = 25;
        let previewTotalPages = 0;
        let statusTimer = null;

        function getCourseId() {
            const selectedId = Number(courseSelect.value);
            return Number.isFinite(selectedId) && selectedId > 0 ? selectedId : fallbackCourseId;
        }

        function getCourseName() {
            return courseSelect.options[courseSelect.selectedIndex]?.textContent?.trim() || 'môn học đang chọn';
        }

        function updateEstimate() {
            const questions = clampNumber(questionsPerChunkInput.value, 1, 5, 2);
            const chunks = clampNumber(maxChunksInput.value, 1, 200, 25);
            estimatedQuestions.textContent = `${questions * chunks} Q&A`;
        }

        function clampNumber(value, min, max, fallback) {
            const parsed = Number(value);
            if (!Number.isFinite(parsed)) return fallback;
            return Math.min(max, Math.max(min, parsed));
        }

        function showToast(message, isError = false) {
            toast.textContent = message;
            toast.classList.toggle('toast-error', isError);
            toast.classList.remove('d-none');
            window.clearTimeout(window.testsetToastTimer);
            window.testsetToastTimer = window.setTimeout(() => toast.classList.add('d-none'), 3600);
        }

        async function postForm(url, data) {
            const body = new URLSearchParams(data);
            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': antiforgeryToken
                },
                body
            });

            if (!response.ok && response.status !== 409) {
                throw new Error(`HTTP ${response.status}`);
            }

            return response.json();
        }

        function setJobRunning(running) {
            generateBtn.disabled = running || !hasCourseOptions;
            stopBtn.disabled = !running || !hasCourseOptions;
            clearBtn.disabled = running || !hasCourseOptions;
            courseSelect.disabled = running || !hasCourseOptions;
            questionsPerChunkInput.disabled = running || !hasCourseOptions;
            maxChunksInput.disabled = running || !hasCourseOptions;
            previewPageSizeSelect.disabled = !hasCourseOptions;
            generateBtn.classList.toggle('is-loading', running);
            generateBtn.querySelector('span').textContent = running ? 'Đang sinh...' : 'Sinh test set';
            jobPanel.classList.toggle('d-none', !running && !jobMessage.textContent);
        }

        function setJobStateBadge(state, isRunning) {
            jobState.className = 'evaluation-status';

            const normalized = String(state || '').toLowerCase();
            if (isRunning || normalized.includes('running') || normalized.includes('processing')) {
                jobState.classList.add('status-running');
            } else if (normalized.includes('fail') || normalized.includes('error')) {
                jobState.classList.add('status-bad');
            } else if (normalized.includes('complete') || normalized.includes('done')) {
                jobState.classList.add('status-good');
            } else {
                jobState.classList.add('status-muted');
            }

            jobState.textContent = state || 'Idle';
        }

        async function refreshStats() {
            const response = await fetch(`/TestSetGenerator?handler=Stats&courseId=${getCourseId()}`);
            const stats = await response.json();
            const coverage = stats.totalChunksAvailable === 0
                ? 0
                : Math.round(stats.uniqueChunksUsed * 100 / stats.totalChunksAvailable);

            document.getElementById('statTotal').textContent = stats.totalCount;
            document.getElementById('statAuto').textContent = stats.autoGeneratedCount;
            document.getElementById('statManual').textContent = stats.manualCount;
            document.getElementById('statUsed').textContent = stats.uniqueChunksUsed;
            document.getElementById('statChunks').textContent = stats.totalChunksAvailable;
            document.getElementById('statCoverage').textContent = `${coverage}%`;
            previewSubtitle.textContent = `Đang xem test set của ${getCourseName()}.`;
        }

        async function refreshPreview() {
            previewList.innerHTML = '<div class="testset-loading"><i class="bi bi-arrow-repeat"></i><span>Đang tải Q&A...</span></div>';
            const response = await fetch(`/TestSetGenerator?handler=Preview&courseId=${getCourseId()}&page=${previewPage}&pageSize=${previewPageSize}`);
            const page = await response.json();
            const items = page.items || [];
            previewTotalPages = page.totalPages || 0;

            if (items.length === 0) {
                previewList.innerHTML = `
                    <div class="empty-state compact">
                        <i class="bi bi-ui-checks"></i>
                        <h3>Chưa có Q&A tự sinh</h3>
                        <p>Chạy generator để tạo test set từ tài liệu đã chunk.</p>
                    </div>`;
            } else {
                previewList.innerHTML = items.map((item, index) => `
                    <article class="testset-qa-card">
                        <div class="testset-qa-index">${((previewPage - 1) * previewPageSize) + index + 1}</div>
                        <div class="testset-qa-body">
                            <span>Câu hỏi</span>
                            <h3>${escapeHtml(item.question || '')}</h3>
                            <span>Đáp án chuẩn</span>
                            <p>${escapeHtml(item.answer || '')}</p>
                            <small><i class="bi bi-link-45deg"></i> Chunk ${item.documentChunkId || 'N/A'} · Độ liên quan ${(item.relevanceScore || 0).toFixed(2)}</small>
                        </div>
                    </article>
                `).join('');
            }

            renderPager();
        }

        function renderPager() {
            const previousDisabled = previewPage <= 1;
            const nextDisabled = previewTotalPages === 0 || previewPage >= previewTotalPages;
            previewPager.innerHTML = `
                <button class="btn btn-sm btn-outline-primary" ${previousDisabled ? 'disabled' : ''} data-page="prev">
                    <i class="bi bi-chevron-left"></i>
                    <span>Trước</span>
                </button>
                <span>Trang ${previewTotalPages === 0 ? 0 : previewPage}/${previewTotalPages}</span>
                <button class="btn btn-sm btn-outline-primary" ${nextDisabled ? 'disabled' : ''} data-page="next">
                    <span>Sau</span>
                    <i class="bi bi-chevron-right"></i>
                </button>`;
        }

        function escapeHtml(value) {
            return String(value)
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }

        async function pollJobStatus() {
            window.clearTimeout(statusTimer);

            const response = await fetch(`/TestSetGenerator?handler=JobStatus&courseId=${getCourseId()}`);
            const status = await response.json();
            const progress = Math.max(0, Math.min(100, status.progressPercent || 0));

            jobPanel.classList.remove('d-none');
            setJobStateBadge(status.state, Boolean(status.isRunning));
            jobTitle.textContent = status.isRunning ? 'Job đang chạy' : 'Generator';
            jobProgressBar.style.width = `${progress}%`;
            jobMessage.textContent = status.message || 'Đang chờ tác vụ...';
            setJobRunning(Boolean(status.isRunning));

            if (status.isRunning) {
                statusTimer = window.setTimeout(pollJobStatus, 1500);
            } else {
                await refreshStats();
                await refreshPreview();
            }
        }

        generateBtn.addEventListener('click', async () => {
            try {
                updateEstimate();
                const result = await postForm('/TestSetGenerator?handler=Generate', {
                    courseId: getCourseId(),
                    questionsPerChunk: clampNumber(questionsPerChunkInput.value, 1, 5, 2),
                    maxChunks: clampNumber(maxChunksInput.value, 1, 200, 25)
                });
                showToast(result.message, !result.success);
                setJobRunning(Boolean(result.success));
                await pollJobStatus();
            } catch (error) {
                showToast(`Không thể bắt đầu generator: ${error.message}`, true);
            }
        });

        stopBtn.addEventListener('click', async () => {
            const result = await postForm('/TestSetGenerator?handler=Stop', { courseId: getCourseId() });
            showToast(result.message, !result.success);
            await pollJobStatus();
        });

        confirmClearBtn.addEventListener('click', async () => {
            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('clearAutoModal'));
            const result = await postForm('/TestSetGenerator?handler=ClearAutoGenerated', { courseId: getCourseId() });
            modal.hide();
            showToast(result.message, !result.success);
            previewPage = 1;
            await refreshStats();
            await refreshPreview();
        });

        previewPager.addEventListener('click', async (event) => {
            const button = event.target.closest('button[data-page]');
            if (!button) return;
            previewPage += button.dataset.page === 'next' ? 1 : -1;
            await refreshPreview();
        });

        previewPageSizeSelect.addEventListener('change', async (event) => {
            previewPageSize = Number(event.target.value);
            previewPage = 1;
            await refreshPreview();
        });

        courseSelect.addEventListener('change', async () => {
            window.clearTimeout(statusTimer);
            previewPage = 1;

            const url = new URL(window.location.href);
            url.searchParams.set('courseId', getCourseId());
            window.history.replaceState(null, '', url);

            jobMessage.textContent = '';
            jobPanel.classList.add('d-none');
            await refreshStats();
            await refreshPreview();
            await pollJobStatus();
        });

        questionsPerChunkInput.addEventListener('input', updateEstimate);
        maxChunksInput.addEventListener('input', updateEstimate);
        updateEstimate();

        if (hasCourseOptions) {
            refreshPreview();
            pollJobStatus();
        } else {
            setJobRunning(false);
            previewList.innerHTML = `
                <div class="empty-state compact">
                    <i class="bi bi-journal-plus"></i>
                    <h3>Chưa có môn học</h3>
                    <p>Tạo môn học trước khi sinh test set.</p>
                </div>`;
            renderPager();
        }
    </script>
}
