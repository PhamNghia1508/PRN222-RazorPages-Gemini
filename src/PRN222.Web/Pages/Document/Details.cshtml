@page "/Document/Details/{id:int}"
@using System.Security.Claims
@using PRN222.Web.Infrastructure
@model PRN222.Web.Pages.Document.DetailsModel
@{
    ViewData["Title"] = Model.Document.OriginalFileName;
    var canUploadDocuments = User.IsInRole(ApplicationRoles.HeadLecturer);
    var isAdmin = User.IsInRole(ApplicationRoles.Admin);
    var canViewChunks = Model.CanViewChunks;
    var isCompleted = string.Equals(Model.Document.Status, "Indexed", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.Document.Status, "Completed", StringComparison.OrdinalIgnoreCase);
    var isProcessing = string.Equals(Model.Document.Status, "Processing", StringComparison.OrdinalIgnoreCase);
    var isFailed = string.Equals(Model.Document.Status, "Failed", StringComparison.OrdinalIgnoreCase);
    var isArchived = string.Equals(Model.Document.Status, "Archived", StringComparison.OrdinalIgnoreCase);
    var isCancelled = string.Equals(Model.Document.Status, "Cancelled", StringComparison.OrdinalIgnoreCase);
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var canCancelUpload = canUploadDocuments &&
        string.Equals(Model.Document.Status, "Uploaded", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(Model.Document.UploadedByUserId, currentUserId, StringComparison.Ordinal);
    var canArchive = isAdmin && !isProcessing && !isArchived && !isCancelled;

    string StatusClass(string status)
    {
        return status?.ToLowerInvariant() switch
        {
            "indexed" => "status-good",
            "completed" => "status-good",
            "processing" => "status-running",
            "failed" => "status-bad",
            "archived" => "status-muted",
            "cancelled" => "status-muted",
            _ => "status-muted"
        };
    }

    string StatusText(string status)
    {
        return status?.ToLowerInvariant() switch
        {
            "indexed" => "Đã index",
            "completed" => "Đã index",
            "processing" => "Đang xử lý",
            "failed" => "Lỗi xử lý",
            "archived" => "Đã tạm ẩn",
            "cancelled" => "Đã hủy tải lên",
            _ => status ?? "Chưa rõ"
        };
    }

    string FormatSize(long bytes)
    {
        if (bytes >= 1024 * 1024) return $"{bytes / 1024d / 1024d:0.0} MB";
        if (bytes >= 1024) return $"{bytes / 1024d:0.0} KB";
        return $"{bytes} B";
    }

    string StepClass(bool done, bool active, bool failed = false)
    {
        if (failed) return "failed";
        if (done) return "done";
        if (active) return "active";
        return string.Empty;
    }
}

<a asp-page="/Document/Index" class="evaluation-back-link fade-in-up">
    <i class="bi bi-arrow-left"></i> Quay lại Knowledge Base
</a>

<section class="ops-hero document-detail-hero fade-in-up">
    <div>
        <span class="section-kicker">Document profile</span>
        <h1>@Model.Document.OriginalFileName</h1>
        <p>
            Tài liệu thuộc môn @Model.Document.CourseName. Đây là nguồn được chunk và đưa vào vector search để RAG trả lời có dẫn chứng.
        </p>
    </div>
    <div class="hero-action-stack">
        @if (canUploadDocuments && !isCompleted && !isProcessing && !isArchived && !isCancelled)
        {
            <form asp-page-handler="Process" asp-route-id="@Model.Document.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-play-circle"></i> Xử lý tài liệu
                </button>
            </form>
        }
        @if (canArchive)
        {
            <button type="button"
                    class="btn btn-outline-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#archiveDocumentModal">
                <i class="bi bi-archive"></i> Tạm ẩn khỏi RAG
            </button>
        }
        @if (canCancelUpload)
        {
            <button type="button"
                    class="btn btn-outline-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#cancelUploadModal">
                <i class="bi bi-x-circle"></i> Hủy tài liệu tải nhầm
            </button>
        }
    </div>
</section>

@if (isFailed && !string.IsNullOrWhiteSpace(Model.Document.ErrorMessage))
{
    <div class="inline-alert inline-alert-danger fade-in-up">
        <i class="bi bi-exclamation-triangle"></i>
        <span>@Model.Document.ErrorMessage</span>
    </div>
}

<section class="document-detail-layout fade-in-up" style="animation-delay: .06s;">
    <aside class="document-facts">
        <article class="document-fact-card">
            <span>Status</span>
            <strong class="evaluation-status @StatusClass(Model.Document.Status)">@StatusText(Model.Document.Status)</strong>
        </article>
        <article class="document-fact-card">
            <span>Chunks</span>
            <strong>@Model.Document.ChunkCount</strong>
            <small>Đoạn văn bản dùng cho retrieval</small>
        </article>
        <article class="document-fact-card">
            <span>File size</span>
            <strong>@FormatSize(Model.Document.FileSize)</strong>
            <small>@Model.Document.ContentType</small>
        </article>
        <article class="document-fact-card">
            <span>Chunking</span>
            <strong>@(string.IsNullOrWhiteSpace(Model.Document.ChunkingStrategy) ? "Default" : Model.Document.ChunkingStrategy)</strong>
            <small>@Model.Document.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
        </article>
    </aside>

    <div class="document-detail-main">
        <section class="workspace-panel">
            <div class="workspace-panel-header">
                <div>
                    <span class="section-kicker">Ingestion pipeline</span>
                    <h2>Trạng thái xử lý tài liệu</h2>
                    <p>Theo dõi tài liệu đi từ upload đến lúc sẵn sàng được RAG truy xuất.</p>
                </div>
            </div>
            <div class="document-pipeline">
                <div class="@StepClass(true, false)">
                    <i class="bi bi-cloud-check"></i>
                    <strong>Upload</strong>
                    <small>File đã vào hệ thống</small>
                </div>
                <div class="@StepClass(isCompleted || Model.Document.ChunkCount > 0, isProcessing, isFailed)">
                    <i class="bi bi-file-earmark-text"></i>
                    <strong>Extract</strong>
                    <small>Đọc nội dung từ tài liệu</small>
                </div>
                <div class="@StepClass(Model.Document.ChunkCount > 0, isProcessing && Model.Document.ChunkCount == 0, isFailed)">
                    <i class="bi bi-layers"></i>
                    <strong>Chunk</strong>
                    <small>Chia nhỏ thành đoạn tìm kiếm</small>
                </div>
                <div class="@StepClass(isCompleted, isProcessing && Model.Document.ChunkCount > 0, isFailed)">
                    <i class="bi bi-diagram-3"></i>
                    <strong>Embedding</strong>
                    <small>Lưu vector vào knowledge base</small>
                </div>
                <div class="@StepClass(isCompleted, false, isFailed)">
                    <i class="bi bi-chat-square-quote"></i>
                    <strong>Ready</strong>
                    <small>Có thể dùng trong chat</small>
                </div>
            </div>
        </section>

        <section class="workspace-panel">
            <div class="workspace-panel-header">
                <div>
                    <span class="section-kicker">Extracted text</span>
                    <h2>Nội dung trích xuất</h2>
                    <p>Preview giúp kiểm tra lỗi OCR/encoding trước khi đưa vào retrieval.</p>
                </div>
            </div>
            @if (!canViewChunks)
            {
                <div class="inline-alert inline-alert-danger mb-0">
                    <i class="bi bi-lock"></i>
                    <span>Tài khoản giảng viên chỉ được xem metadata tài liệu, không được xem nội dung trích xuất hoặc chunk.</span>
                </div>
            }
            else
            {
                <div class="document-preview-box">
                    @if (string.IsNullOrWhiteSpace(Model.Document.ExtractedTextPreview))
                    {
                        <p class="text-muted mb-0">Chưa có nội dung trích xuất để hiển thị.</p>
                    }
                    else
                    {
                        <p>@Model.Document.ExtractedTextPreview</p>
                    }
                </div>
            }
        </section>

        @if (canViewChunks)
        {
            <section class="workspace-panel">
                <div class="workspace-panel-header">
                    <div>
                        <span class="section-kicker">Chunks</span>
                        <h2>Evidence chunks</h2>
                        <p>Các chunk bên dưới là đơn vị được vector search trả về khi người dùng hỏi.</p>
                    </div>
                </div>
                @if (!Model.Document.Chunks.Any())
                {
                    <div class="empty-state compact">
                        <i class="bi bi-layers"></i>
                        <h3>Chưa có chunk</h3>
                        <p>Hãy chạy xử lý tài liệu để tạo chunk và embedding.</p>
                    </div>
                }
                else
                {
                    <div class="document-chunk-list">
                        @foreach (var chunk in Model.Document.Chunks.OrderBy(x => x.ChunkIndex))
                        {
                            <article class="document-chunk-card">
                                <div class="document-chunk-head">
                                    <strong>Chunk @chunk.ChunkIndex</strong>
                                    <span>@chunk.TokenCount tokens</span>
                                </div>
                                <p>@chunk.Content</p>
                            </article>
                        }
                    </div>
                }
            </section>
        }
    </div>
</section>

<section class="workspace-panel fade-in-up" aria-labelledby="upload-audit-title">
    <div class="workspace-panel-header">
        <div>
            <span class="section-kicker">Upload accountability</span>
            <h2 id="upload-audit-title">Trách nhiệm học liệu</h2>
        </div>
    </div>
    @if (Model.Document.UploadedAt.HasValue)
    {
        <dl class="row mb-0">
            <dt class="col-sm-3">Người tải lên</dt>
            <dd class="col-sm-9">@(Model.Document.UploadedByEmail ?? "Tài khoản không còn khả dụng")</dd>
            <dt class="col-sm-3">Thời gian tải lên</dt>
            <dd class="col-sm-9">@Model.Document.UploadedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-3">Môn học</dt>
            <dd class="col-sm-9">@Model.Document.CourseName</dd>
            <dt class="col-sm-3">Khoa/Bộ môn</dt>
            <dd class="col-sm-9">@(Model.Document.DepartmentName ?? "Chưa xác định")</dd>
            <dt class="col-sm-3">Trạng thái hiện tại</dt>
            <dd class="col-sm-9">@StatusText(Model.Document.Status)</dd>
        </dl>
    }
    else
    {
        <div class="inline-alert mb-0">
            <i class="bi bi-info-circle"></i>
            <span>Không có dữ liệu người tải lên — tài liệu được tạo trước khi tính năng truy vết upload được bổ sung.</span>
        </div>
    }
</section>

@if (isArchived)
{
    <section class="workspace-panel fade-in-up" aria-labelledby="archive-audit-title">
        <div class="workspace-panel-header">
            <div>
                <span class="section-kicker">Archive audit</span>
                <h2 id="archive-audit-title">Thông tin tạm ẩn</h2>
            </div>
        </div>
        @if (Model.Document.ArchivedAt.HasValue)
        {
            <dl class="row mb-0">
                <dt class="col-sm-3">Người thực hiện</dt>
                <dd class="col-sm-9">@(Model.Document.ArchivedByEmail ?? "Tài khoản không còn khả dụng")</dd>
                <dt class="col-sm-3">Thời gian</dt>
                <dd class="col-sm-9">@Model.Document.ArchivedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                <dt class="col-sm-3">Trạng thái trước đó</dt>
                <dd class="col-sm-9">@(Model.Document.ArchivedFromStatus ?? "Không xác định")</dd>
                <dt class="col-sm-3">Lý do</dt>
                <dd class="col-sm-9">@(Model.Document.ArchiveReason ?? "Không có lý do được lưu")</dd>
            </dl>
        }
        else
        {
            <div class="inline-alert mb-0">
                <i class="bi bi-info-circle"></i>
                <span>Chưa có dữ liệu audit cho lần tạm ẩn này.</span>
            </div>
        }
    </section>
}

@if (isCancelled)
{
    <section class="workspace-panel fade-in-up" aria-labelledby="cancellation-audit-title">
        <div class="workspace-panel-header">
            <div>
                <span class="section-kicker">Cancellation audit</span>
                <h2 id="cancellation-audit-title">Thông tin hủy tải lên</h2>
            </div>
        </div>
        @if (Model.Document.CancelledAt.HasValue)
        {
            <dl class="row mb-0">
                <dt class="col-sm-3">Người thực hiện</dt>
                <dd class="col-sm-9">@(Model.Document.CancelledByEmail ?? "Tài khoản không còn khả dụng")</dd>
                <dt class="col-sm-3">Thời gian</dt>
                <dd class="col-sm-9">@Model.Document.CancelledAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                <dt class="col-sm-3">Lý do</dt>
                <dd class="col-sm-9">@(Model.Document.CancellationReason ?? "Không có lý do được lưu")</dd>
            </dl>
        }
        else
        {
            <div class="inline-alert mb-0">
                <i class="bi bi-info-circle"></i>
                <span>Không có dữ liệu hủy tải lên.</span>
            </div>
        }
    </section>
}

@if (canCancelUpload)
{
    <div class="modal fade" id="cancelUploadModal" tabindex="-1" aria-labelledby="cancelUploadModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-page-handler="CancelUpload" asp-route-id="@Model.Document.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="cancelUploadModalLabel">Hủy tài liệu tải nhầm</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body">
                        <p>Tài liệu sẽ được đánh dấu là đã hủy tải lên. File và dữ liệu liên quan vẫn được giữ lại để truy vết.</p>
                        <label for="cancellationReason" class="form-label">Lý do hủy tài liệu tải nhầm</label>
                        <textarea id="cancellationReason"
                                  name="cancellationReason"
                                  class="form-control"
                                  rows="4"
                                  maxlength="1000"
                                  required
                                  placeholder="Nhập lý do hủy, ví dụ: tải nhầm phiên bản hoặc sai môn học."></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-x-circle"></i> Hủy tài liệu tải nhầm
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (canArchive)
{
    <div class="modal fade" id="archiveDocumentModal" tabindex="-1" aria-labelledby="archiveDocumentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-page-handler="Archive" asp-route-id="@Model.Document.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="archiveDocumentModalLabel">Xác nhận tạm ẩn tài liệu</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body">
                        <p>Tài liệu sẽ bị tạm ẩn khỏi RAG nhưng vẫn được giữ lại để truy vết. Bạn có chắc chắn không?</p>
                        <label for="archiveReason" class="form-label">Lý do tạm ẩn</label>
                        <textarea id="archiveReason"
                                  name="archiveReason"
                                  class="form-control"
                                  rows="4"
                                  maxlength="1000"
                                  required></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-archive"></i> Tạm ẩn khỏi RAG
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @if (isProcessing)
            {
                <text>window.setTimeout(function () { window.location.reload(); }, 5000);</text>
            }
        });
    </script>
}

